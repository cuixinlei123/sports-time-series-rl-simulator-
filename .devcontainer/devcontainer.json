{
  "name": "Sports‑Time‑Series‑RL‑Simulator Dev Environment",
  "image": "mcr.microsoft.com/devcontainers/python:3.11‑bookworm",
  "features": {
    "docker‑in‑docker": {
      "version": "latest"
    }
  },
  "forwardPorts": [
    3000,
    5000,
    8060,
    9090,
    9092
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml"
      ]
    }
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "remoteUser": "vscode"
}
